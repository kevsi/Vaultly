{
  "manifest_version": 3,
  "name": "Vaultly",
  "version": "1.1.0",
  "description": "Ajoute la page courante à ta bibliothèque Vaultly en un clic. 100 % local.",
  "homepage_url": "https://github.com/kevsi/Vaultly",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://127.0.0.1:8766/*",
    "http://127.0.0.1:8767/*",
    "http://127.0.0.1:8768/*",
    "http://127.0.0.1:8769/*",
    "http://127.0.0.1:8770/*",
    "http://127.0.0.1:8771/*",
    "http://127.0.0.1:8772/*",
    "http://127.0.0.1:8773/*",
    "http://127.0.0.1:8774/*",
    "http://127.0.0.1:8775/*",
    "http://127.0.0.1:8776/*",
    "http://127.0.0.1:8777/*",
    "http://127.0.0.1:8778/*",
    "http://127.0.0.1:8779/*",
    "http://127.0.0.1:8780/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ajouter à Vaultly",
    "default_icon": {
      "32": "icons/32.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "128": "icons/128.png"
  }
}
